# hal - the Wave 1 hardware abstraction contract.
#
# Three .h.ct traits plus one .m.ct namespace entry (hal::Clock); no
# implementation and no C translation unit of its own. A platform package
# (hal-posix) implements the traits and provides the C symbol behind the clock
# entry; a consumer imports the traits and boxes whatever instance the platform
# package publishes.
name = hal
version = 0.1.0
licence = MIT
