/*
 * MemUart.h.ct - stores accepted bytes in an 8-byte buffer.
 *
 * `send` refuses a write that would exceed the buffer; `recv` copies at most
 * `len` stored bytes and does not consume them. The capacity is deliberately
 * small so the boundary tests can hit 0, exactly full, and one byte over.
 *
 * License: MIT (see LICENSE).
 */

import hal::Uart;

pub struct MemUart {
    char buf[8];
    int len;
} use Uart;

impl Uart for MemUart {
    int send(char *b, int n) {
        int i;
        if (n < 0 || self->len + n > 8) return -1;
        i = 0;
        while (i < n) {
            self->buf[self->len + i] = b[i];
            i = i + 1;
        }
        self->len = self->len + n;
        return n;
    }

    int recv(char *b, int n) {
        int i;
        if (n < 0) return -1;
        i = 0;
        while (i < self->len && i < n) {
            b[i] = self->buf[i];
            i = i + 1;
        }
        return i;
    }
}
