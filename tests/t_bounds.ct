/*
 * t_bounds.ct - hal::Uart buffer boundaries on the 8-byte MemUart.
 *
 * Covers: 0 bytes, exactly filling the buffer, one byte over (must fail and
 * change nothing), recv into a larger buffer (must not write past the stored
 * length), and recv of a prefix.
 *
 * License: MIT (see LICENSE).
 */

#include <stdio.h>

import hal::Uart;
import support::MemUart;

static int checks = 0;
static int failures = 0;

void check(int cond, char *what) {
    checks = checks + 1;
    if (!cond) {
        failures = failures + 1;
        printf("FAIL: %s\n", what);
    }
}

int same(char *a, char *b, int n) {
    int i;
    i = 0;
    while (i < n) {
        if (a[i] != b[i]) return 0;
        i = i + 1;
    }
    return 1;
}

int main(void) {
    MemUart m = { .len = 0 };
    Uart u = m;
    char out[16];
    int n;

    check(u.send("abcde", 5) == 5, "send 5 into an empty buffer");
    check(u.send("fgh", 3) == 3, "send 3 exactly fills the buffer");
    check(m.len == 8, "buffer is full at 8");

    check(u.send("i", 1) == -1, "one byte over capacity fails");
    check(m.len == 8, "overflow leaves length at 8");
    check(u.send("i", 0) == 0, "zero length still legal when full");
    check(u.send("i", -1) == -1, "negative length fails when full");

    out[8] = 127;
    n = u.recv(out, 16);
    check(n == 8, "recv into a larger buffer returns 8");
    check(same(out, "abcdefgh", 8), "content survives the exact fill");
    check(out[8] == 127, "recv does not write past the stored length");

    check(u.recv(out, 3) == 3, "prefix recv returns 3");
    check(same(out, "abc", 3), "prefix recv starts at byte 0");
    check(u.recv(out, 0) == 0, "zero length recv returns 0");

    printf("checks=%d failures=%d\n", checks, failures);
    if (failures != 0) return 1;
    return 0;
}
