/*
 * t_uart.ct - hal::Uart send/recv semantics.
 *
 * Covers: positive lengths, zero length, negative length, appending sends,
 * recv of a prefix, recv from an empty object. Content is asserted byte by
 * byte so a wrong buffer offset fails the test.
 *
 * License: MIT (see LICENSE).
 */

#include <stdio.h>

import hal::Uart;
import support::MemUart;

static int checks = 0;
static int failures = 0;

void check(int cond, char *what) {
    checks = checks + 1;
    if (!cond) {
        failures = failures + 1;
        printf("FAIL: %s\n", what);
    }
}

int same(char *a, char *b, int n) {
    int i;
    i = 0;
    while (i < n) {
        if (a[i] != b[i]) return 0;
        i = i + 1;
    }
    return 1;
}

int main(void) {
    MemUart m = { .len = 0 };
    MemUart empty = { .len = 0 };
    Uart u = m;
    Uart ue = empty;
    char out[8];
    char small[4];
    int n;

    check(u.send("abc", 3) == 3, "send 3 returns 3");
    check(m.len == 3, "send 3 stored 3");

    check(u.send("x", 0) == 0, "send zero length returns 0");
    check(m.len == 3, "send zero length stores nothing");

    check(u.send("x", -1) == -1, "send negative length fails");
    check(m.len == 3, "send negative length stores nothing");

    check(u.send("de", 2) == 2, "second send appends");
    check(m.len == 5, "second send grows length to 5");

    n = u.recv(out, 8);
    out[n] = 0;
    check(n == 5, "recv returns all stored bytes");
    check(same(out, "abcde", 5), "recv preserves order");

    n = u.recv(small, 2);
    small[n] = 0;
    check(n == 2, "recv honours a smaller buffer");
    check(same(small, "ab", 2), "recv fills only the requested prefix");

    check(u.recv(out, 0) == 0, "recv zero length returns 0");
    check(u.recv(out, -1) == -1, "recv negative length fails");
    check(ue.recv(out, 8) == 0, "recv from an empty object returns 0");

    printf("checks=%d failures=%d\n", checks, failures);
    if (failures != 0) return 1;
    return 0;
}
